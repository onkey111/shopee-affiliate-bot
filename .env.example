# ==============================================================================
# SHOPEE AFFILIATE BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values
# Sao chép file này thành .env và điền các giá trị của bạn
# ==============================================================================


# ==============================================================================
# 1. TELEGRAM BOT CONFIGURATION
# Cấu hình Bot Telegram
# ==============================================================================

# [REQUIRED] Telegram Bot Token
# Lấy từ @BotFather trên Telegram:
#   1. Mở Telegram, tìm @BotFather
#   2. Gửi /newbot và làm theo hướng dẫn
#   3. Copy token có dạng: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Get from @BotFather on Telegram:
#   1. Open Telegram, search for @BotFather
#   2. Send /newbot and follow instructions
#   3. Copy the token like: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_telegram_bot_token


# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# Cấu hình Database PostgreSQL
# ==============================================================================

# [OPTION 1] Full connection string (recommended for production)
# Chuỗi kết nối đầy đủ (khuyến nghị cho production)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopee_bot

# [OPTION 2] Individual connection parameters (used if DATABASE_URL not set)
# Các tham số kết nối riêng lẻ (dùng khi không có DATABASE_URL)

# Database host - Default: localhost
# Địa chỉ máy chủ database
DB_HOST=localhost

# Database port - Default: 5432
# Cổng kết nối database
DB_PORT=5432

# Database name - Default: shopee_bot
# Tên database
DB_NAME=shopee_bot

# Database user - Default: postgres
# Tên người dùng database
DB_USER=postgres

# Database password - Default: postgres
# Mật khẩu database
# ⚠️ PRODUCTION: Use a strong password!
# ⚠️ PRODUCTION: Sử dụng mật khẩu mạnh!
DB_PASSWORD=postgres


# ==============================================================================
# 3. REDIS CONFIGURATION (for BullMQ Queue)
# Cấu hình Redis cho hàng đợi BullMQ
# ==============================================================================
# Redis is required for the job queue system
# Redis cần thiết cho hệ thống hàng đợi công việc

# Redis host - Default: localhost
# Địa chỉ máy chủ Redis
REDIS_HOST=localhost

# Redis port - Default: 6379
# Cổng kết nối Redis
REDIS_PORT=6379

# [OPTIONAL] Redis password - Default: empty (no password)
# Mật khẩu Redis (tùy chọn)
# Leave empty for local development without password
# Để trống cho môi trường phát triển local không có mật khẩu
# ⚠️ PRODUCTION: Always set a password!
# ⚠️ PRODUCTION: Luôn đặt mật khẩu!
REDIS_PASSWORD=


# ==============================================================================
# 4. BROWSER POOL CONFIGURATION (Puppeteer)
# Cấu hình Pool Browser cho Puppeteer
# ==============================================================================
# Browser pool manages Puppeteer instances for affiliate link conversion
# Pool browser quản lý các instance Puppeteer để chuyển đổi link affiliate

# Minimum browsers to keep warm - Default: 2
# Số browser tối thiểu luôn sẵn sàng
# Recommended: 2 for development, 3-4 for production
# Khuyến nghị: 2 cho development, 3-4 cho production
BROWSER_POOL_MIN=2

# Maximum browsers allowed - Default: 5
# Số browser tối đa được phép
# Recommended based on server resources:
#   - 2 cores / 4GB RAM: 3-4 browsers
#   - 4 cores / 8GB RAM: 6-8 browsers
#   - 8 cores / 16GB RAM: 10-12 browsers
# Khuyến nghị dựa trên tài nguyên server:
#   - 2 cores / 4GB RAM: 3-4 browsers
#   - 4 cores / 8GB RAM: 6-8 browsers
#   - 8 cores / 16GB RAM: 10-12 browsers
BROWSER_POOL_MAX=5

# Acquire timeout in milliseconds - Default: 10000 (10 seconds)
# Thời gian chờ lấy browser từ pool (ms)
# If no browser available within this time, request fails
# Nếu không có browser sẵn sàng trong thời gian này, request sẽ thất bại
BROWSER_POOL_ACQUIRE_TIMEOUT=10000

# Idle timeout in milliseconds - Default: 30000 (30 seconds)
# Thời gian browser không hoạt động trước khi bị đóng (ms)
# Browsers idle longer than this will be destroyed
# Browser không hoạt động lâu hơn thời gian này sẽ bị hủy
BROWSER_POOL_IDLE_TIMEOUT=30000


# ==============================================================================
# 5. ADMIN PANEL CONFIGURATION
# Cấu hình Admin Panel
# ==============================================================================

# Admin username - Default: admin
# Tên đăng nhập admin
ADMIN_USER=admin

# Admin password - Default: admin123
# Mật khẩu admin
# ⚠️ PRODUCTION: Change this immediately!
# ⚠️ PRODUCTION: Thay đổi ngay lập tức!
ADMIN_PASSWORD=changeme

# Session secret for express-session - Default: change-me-in-production
# Khóa bí mật cho session
# Generate a random string: openssl rand -base64 32
# Tạo chuỗi ngẫu nhiên: openssl rand -base64 32
# ⚠️ PRODUCTION: Use a long random string!
# ⚠️ PRODUCTION: Sử dụng chuỗi ngẫu nhiên dài!
SESSION_SECRET=random-secret-key-change-in-production

# [OPTIONAL] Admin alert Telegram ID
# ID Telegram để nhận cảnh báo admin (tùy chọn)
# Get your chat ID:
#   1. Message @userinfobot on Telegram
#   2. It will reply with your user ID
# Lấy chat ID của bạn:
#   1. Nhắn tin cho @userinfobot trên Telegram
#   2. Bot sẽ trả lời với user ID của bạn
# Leave empty to disable admin alerts
# Để trống để tắt cảnh báo admin
ADMIN_ALERT_TELEGRAM_ID=


# ==============================================================================
# 6. APPLICATION SETTINGS
# Cài đặt ứng dụng
# ==============================================================================

# Node environment - Default: development
# Môi trường Node.js
# Options: development, production, test
# Các tùy chọn: development, production, test
NODE_ENV=development

# Application port - Default: 3000
# Cổng ứng dụng
# Admin panel will be available at http://localhost:PORT/admin
# Admin panel sẽ có tại http://localhost:PORT/admin
PORT=3000


# ==============================================================================
# 7. NGROK CONFIGURATION (Development Only)
# Cấu hình Ngrok (Chỉ dùng cho Development)
# ==============================================================================
# Ngrok creates a public URL for local development
# Ngrok tạo URL công khai cho phát triển local
# Required for Telegram webhook in development
# Cần thiết cho Telegram webhook trong môi trường development

# [OPTIONAL] Ngrok auth token
# Token xác thực Ngrok (tùy chọn)
# Get from: https://dashboard.ngrok.com/get-started/your-authtoken
# Lấy từ: https://dashboard.ngrok.com/get-started/your-authtoken
#   1. Sign up at ngrok.com
#   2. Go to dashboard -> Your Authtoken
#   3. Copy the token
# Steps:
#   1. Đăng ký tại ngrok.com
#   2. Vào dashboard -> Your Authtoken
#   3. Copy token
NGROK_AUTHTOKEN=


# ==============================================================================
# 8. PRODUCTION WEBHOOK CONFIGURATION
# Cấu hình Webhook cho Production
# ==============================================================================
# For production deployment on VPS without ngrok
# Dùng cho triển khai production trên VPS không cần ngrok

# [REQUIRED for production] Full public webhook URL
# URL webhook công khai đầy đủ (bắt buộc cho production)
# Example: https://yourdomain.com/webhook/bot
# Ví dụ: https://yourdomain.com/webhook/bot
# Must be HTTPS and publicly accessible
# Phải là HTTPS và có thể truy cập công khai
WEBHOOK_URL=


# ==============================================================================
# NOTES / GHI CHÚ
# ==============================================================================
#
# REQUIRED VARIABLES (Bắt buộc):
#   - BOT_TOKEN
#   - DATABASE_URL (or DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD)
#   - REDIS_HOST, REDIS_PORT (for queue functionality)
#
# PRODUCTION CHECKLIST (Danh sách kiểm tra Production):
#   ✓ Change ADMIN_PASSWORD to a strong password
#   ✓ Generate a random SESSION_SECRET
#   ✓ Set REDIS_PASSWORD if Redis is exposed
#   ✓ Set NODE_ENV=production
#   ✓ Configure ADMIN_ALERT_TELEGRAM_ID for monitoring
#   ✓ Adjust BROWSER_POOL_MAX based on server resources
#
# DOCKER COMPOSE:
#   If using docker-compose.yml, PostgreSQL is pre-configured with:
#   - Host: localhost (or postgres if inside Docker network)
#   - Port: 5432
#   - User: postgres
#   - Password: postgres
#   - Database: shopee_bot
#
# ==============================================================================
