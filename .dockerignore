# ==============================================================================
# Docker Ignore File
# Excludes files from Docker build context
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (use Docker env vars instead)
.env
.env.local
.env.*.local

# Development files
.git/
.gitignore
.vscode/
.idea/
*.md
!README.md

# Test files
test/
tests/
*.test.js
*.spec.js
coverage/

# Build artifacts
dist/
build/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# Plans and documentation
plans/
docs/

# Claude/AI files
.claude/
CLAUDE.md
AGENTS.md

# Development entry points (use index-webhook.js for production)
index.js
index-polling.js

# Test files
test-*.js

# Docker files (no need to include in context except entrypoint)
Dockerfile*
docker-compose*.yml
dokploy.yml
.dockerignore
!docker-entrypoint.sh

# Data directory (mounted as volume)
data/

# Temporary files
tmp/
temp/
*.tmp

